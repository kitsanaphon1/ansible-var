/**
 * 🔧 Jenkins Pipeline: สร้างหรือทำลาย VM บน Azure ด้วย Ansible และ config-dev.yaml
 *
 * ✅ แก้ DESTROY_MODE = "false" → เพื่อสร้าง VM และดึง IP
 * ✅ แก้ DESTROY_MODE = "true"  → เพื่อลบ VM และทรัพยากรทั้งหมดตาม config
 */

pipeline {
  agent { label 'ansible-agent' }

  environment {
    SSH_KEY = "~/.ssh/id_rsa"
    ANSIBLE_ENV_PATH = "/var/lib/jenkins/ansible-azure-env"
    DESTROY_MODE = "false" // ✅ แก้เป็น "true" เพื่อเปลี่ยนโหมดเป็นลบ
  }

  stages {
    stage('🧹 Clean Workspace') {
      steps {
        echo "📦 ล้าง workspace เพื่อเตรียมพื้นที่ clean build..."
        cleanWs()
      }
    }

    stage('📥 Checkout Source Code') {
      steps {
        echo "📥 ดึง source code จาก Git Repository"
        checkout scm
      }
    }

    stage('⚙️ Provision หรือ Destroy VM') {
      steps {
        echo "🔎 ตรวจสอบ DESTROY_MODE = ${DESTROY_MODE}"
        withCredentials([
          string(credentialsId: 'AZURE_CLIENT_ID', variable: 'AZURE_CLIENT_ID'),
          string(credentialsId: 'AZURE_SECRET', variable: 'AZURE_SECRET'),
          string(credentialsId: 'AZURE_TENANT', variable: 'AZURE_TENANT'),
          string(credentialsId: 'AZURE_SUBSCRIPTION_ID', variable: 'AZURE_SUBSCRIPTION_ID')
        ]) {
          script {
            if (env.DESTROY_MODE == "true") {
              echo "🗑 ลบ VM และทรัพยากรที่เกี่ยวข้อง (จาก config-dev.yaml)..."
              sh '''
                set -ex
                . $ANSIBLE_ENV_PATH/bin/activate
                ansible-playbook playbooks/destroy-linux-vm.yaml -e "@config/config-dev.yaml"
              '''
            } else {
              echo "🚀 สร้าง VM ตาม config-dev.yaml..."
              sh '''
                set -ex
                . $ANSIBLE_ENV_PATH/bin/activate
                ansible-playbook playbooks/create-linux-vm.yaml -e "@config/config-dev.yaml"
              '''
            }
          }
        }
      }
    }

    stage('🌐 Get Public IP') {
      when {
        expression { env.DESTROY_MODE == "false" }
      }
      steps {
        withCredentials([
          string(credentialsId: 'AZURE_CLIENT_ID', variable: 'AZURE_CLIENT_ID'),
          string(credentialsId: 'AZURE_SECRET', variable: 'AZURE_SECRET'),
          string(credentialsId: 'AZURE_TENANT', variable: 'AZURE_TENANT'),
          string(credentialsId: 'AZURE_SUBSCRIPTION_ID', variable: 'AZURE_SUBSCRIPTION_ID')
        ]) {
          echo "🧹 ลบไฟล์ vm_ip.txt เก่า (ถ้ามี)..."
          sh 'rm -f vm_ip.txt || true'

          echo "🌐 ดึง Public IP จาก Azure"
          sh '''
            set -ex
            . $ANSIBLE_ENV_PATH/bin/activate
            ansible-playbook playbooks/get-vm-ip.yaml -e "@config/config-dev.yaml"
            echo "📄 ตรวจ vm_ip.txt:"
            cat vm_ip.txt
          '''
        }
      }
    }

    stage('🐳 Install Docker & Docker Compose') {
      when {
        expression { env.DESTROY_MODE == "false" }
      }
      steps {
        withCredentials([
          string(credentialsId: 'AZURE_CLIENT_ID', variable: 'AZURE_CLIENT_ID'),
          string(credentialsId: 'AZURE_SECRET', variable: 'AZURE_SECRET'),
          string(credentialsId: 'AZURE_TENANT', variable: 'AZURE_TENANT'),
          string(credentialsId: 'AZURE_SUBSCRIPTION_ID', variable: 'AZURE_SUBSCRIPTION_ID')
        ]) {
          script {
            def ip = readFile('vm_ip.txt').trim()
            echo "🔧 ติดตั้ง Docker & Docker Compose บนเครื่อง ${ip}"

            sh """
              set -ex
              . $ANSIBLE_ENV_PATH/bin/activate
              ansible-playbook -i ${ip}, \
                -u azureuser --private-key ${SSH_KEY} \
                playbooks/install-Docker&docker-compose.yaml
            """
          }
        }
      }
    }
  }
}
