pipeline {
  agent { label 'ansible-agent' } // 👷‍♂️ ระบุให้รันบน agent ที่มี label นี้

  environment {
    SSH_KEY = "/var/lib/jenkins/.ssh/id_rsa_ansible_final"    // 🔐 private key ที่ Jenkins ใช้ SSH เข้า VM
    SSH_USER = "azureuser"                                     // 👤 ชื่อผู้ใช้บน VM ที่ต้องการ SSH เข้าไป
    ANSIBLE_ENV_PATH = "/var/lib/jenkins/ansible-azure-env"   // 📦 path ไปยัง Python Virtual Environment ของ Ansible
    DESTROY_MODE = "false"                                     // 🧨 ถ้าเป็น "true" จะลบ VM, ถ้าเป็น "false" จะสร้าง VM
    ANSIBLE_HOST_KEY_CHECKING = "False"                        // ✅ ปิดการตรวจสอบ SSH host key (ป้องกันปัญหา unknown fingerprint)
  }

  stages {

    stage('🧹 Clean Workspace') {
      steps {
        echo "📦 ล้าง workspace เพื่อเตรียม clean build..."
        cleanWs() // 🧽 ลบไฟล์จาก build ก่อนหน้า เพื่อให้แน่ใจว่าเป็น clean environment
      }
    }

    stage('📥 Checkout Source Code') {
      steps {
        echo "📥 ดึง source code จาก Git Repository"
        checkout scm // 📦 ดึงโค้ดจาก Git repo ที่ผูกกับ job นี้
      }
    }

    stage('⚙️ Provision หรือ Destroy VM') {
      steps {
        echo "🔎 ตรวจสอบ DESTROY_MODE = ${DESTROY_MODE}"
        withCredentials([
          string(credentialsId: 'AZURE_CLIENT_ID', variable: 'AZURE_CLIENT_ID'),
          string(credentialsId: 'AZURE_SECRET', variable: 'AZURE_SECRET'),
          string(credentialsId: 'AZURE_TENANT', variable: 'AZURE_TENANT'),
          string(credentialsId: 'AZURE_SUBSCRIPTION_ID', variable: 'AZURE_SUBSCRIPTION_ID')
        ]) {
          script {
            // 🎯 เลือกว่าจะ run playbook ไหน ขึ้นกับ DESTROY_MODE
            def playbook = env.DESTROY_MODE == "true" ? "destroy-linux-vm.yaml" : "create-linux-vm.yaml"
            echo env.DESTROY_MODE == "true" ? "🗑 ลบ VM..." : "🚀 สร้าง VM..."

            // 🛠️ รัน playbook ที่เลือก โดย activate venv ก่อน
            sh """
              set -ex
              . $ANSIBLE_ENV_PATH/bin/activate
              ansible-playbook playbooks/${playbook} -e "@config/config-dev.yaml"
            """
          }
        }
      }
    }

    stage('🌐 Get Public IP') {
      when {
        expression { env.DESTROY_MODE?.toLowerCase() == "false" } // ✅ รันเฉพาะตอนสร้าง VM เท่านั้น
      }
      steps {
        withCredentials([
          string(credentialsId: 'AZURE_CLIENT_ID', variable: 'AZURE_CLIENT_ID'),
          string(credentialsId: 'AZURE_SECRET', variable: 'AZURE_SECRET'),
          string(credentialsId: 'AZURE_TENANT', variable: 'AZURE_TENANT'),
          string(credentialsId: 'AZURE_SUBSCRIPTION_ID', variable: 'AZURE_SUBSCRIPTION_ID')
        ]) {
          echo "🌐 ดึง Public IP จาก Azure"
          sh '''
            set -ex
            rm -f vm_ip.txt || true  // 🧹 ล้างไฟล์ IP เก่า
            . $ANSIBLE_ENV_PATH/bin/activate
            ansible-playbook playbooks/get-vm-ip.yaml -e "@config/config-dev.yaml"
            echo "📄 ตรวจ vm_ip.txt:"
            cat vm_ip.txt // ✅ แสดง IP ที่ได้
          '''
        }
      }
    }

    stage('🐳 Install Docker & Docker Compose') {
      when {
        expression { env.DESTROY_MODE?.toLowerCase() == "false" } // ✅ รันเฉพาะตอนสร้าง VM เท่านั้น
      }
      steps {
        script {
          if (!fileExists('vm_ip.txt')) {
            error "❌ ไม่พบไฟล์ vm_ip.txt" // ⚠️ หากไม่มีไฟล์ IP หยุดทันที
          }

          def ip = readFile('vm_ip.txt').trim() // 📥 อ่าน IP จากไฟล์
          echo "🔧 ติดตั้ง Docker & Docker Compose บนเครื่อง ${ip}"

          // 🛠️ รัน Ansible เพื่อติดตั้ง Docker บนเครื่องที่เพิ่งสร้าง
          sh """
            set -ex
            . \$ANSIBLE_ENV_PATH/bin/activate
            ansible-playbook -i ${ip}, -u \$SSH_USER --private-key \$SSH_KEY playbooks/install-Docker.yaml
          """
        }
      }
    }
  }
}
