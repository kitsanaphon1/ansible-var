/**
 * 🔧 Jenkins Pipeline: สร้างหรือทำลาย VM บน Azure ด้วย Ansible และ config-dev.yaml
 *
 * ✅ DESTROY_MODE = false → สร้าง VM จาก config-dev.yaml
 * ✅ DESTROY_MODE = true  → ลบ VM และทรัพยากรที่เกี่ยวข้องจาก config-dev.yaml
 */

pipeline {
  agent { label 'ansible-agent' }

  parameters {
    booleanParam(
      name: 'DESTROY_MODE',
      defaultValue: true,
      description: '✅ ไม่ติ๊ก = สร้าง VM / 🗑 ติ๊ก = ลบ VM ตาม config-dev.yaml'
    )
  }

  environment {
    SSH_KEY = "~/.ssh/id_rsa"
    ANSIBLE_ENV_PATH = "/var/lib/jenkins/ansible-azure-env"
  }

  stages {
    stage('🧹 Clean Workspace') {
      steps {
        echo "📦 ล้าง workspace เพื่อเตรียมพื้นที่ clean build..."
        cleanWs()
      }
    }

    stage('📥 Checkout Source Code') {
      steps {
        echo "📥 ดึง source code จาก Git Repository"
        checkout scm
      }
    }

    stage('⚙️ Provision หรือ Destroy VM') {
      steps {
        echo "🔎 ตรวจสอบ DESTROY_MODE: ${params.DESTROY_MODE}"

        withCredentials([
          string(credentialsId: 'AZURE_CLIENT_ID', variable: 'AZURE_CLIENT_ID'),
          string(credentialsId: 'AZURE_SECRET', variable: 'AZURE_SECRET'),
          string(credentialsId: 'AZURE_TENANT', variable: 'AZURE_TENANT'),
          string(credentialsId: 'AZURE_SUBSCRIPTION_ID', variable: 'AZURE_SUBSCRIPTION_ID')
        ]) {
          script {
            if (params.DESTROY_MODE) {
              echo "🗑 กำลังลบ VM ตาม config-dev.yaml..."

              // ✅ คำอธิบาย:
              // - ระบบจะโหลดค่า config จาก config-dev.yaml
              // - แล้วใช้ลบ VM และทรัพยากรอื่น ๆ ที่เกี่ยวข้อง เช่น:
              //   • Virtual Machine
              //   • Network Interface (NIC)
              //   • Public IP Address
              //   • Network Security Group (NSG)
              //   • Subnet และ Virtual Network (ถ้าถูกกำหนดไว้)
              // - ทั้งหมดจะอ้างอิงจากชื่อใน config
              // ❗ ระวัง: ถ้ามี resource ที่ใช้ชื่อนี้อยู่จริง → จะถูกลบทันที

              sh '''
                set -ex
                export ANSIBLE_HOST_KEY_CHECKING=False
                . $ANSIBLE_ENV_PATH/bin/activate
                ansible-playbook playbooks/destroy-linux-vm.yaml \
                  -e "@config/config-dev.yaml"
              '''
            } else {
              echo "🚀 กำลังสร้าง VM ตาม config-dev.yaml..."
              sh '''
                set -ex
                export ANSIBLE_HOST_KEY_CHECKING=False
                . $ANSIBLE_ENV_PATH/bin/activate
                ansible-playbook playbooks/create-linux-vm.yaml \
                  -e "@config/config-dev.yaml"
              '''
            }
          }
        }
      }
    }
  }
}
