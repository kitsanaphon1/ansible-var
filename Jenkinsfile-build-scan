pipeline {
  agent { label 'ansible-agent' }

  environment {
    SSH_KEY = "~/.ssh/id_rsa_ansible_final"    // ✅ ใช้ key ที่ match กับ .pub ใน VM
    SSH_USER = "azureuser"                     // ✅ ต้องตรงกับ admin_username ใน playbook
    ANSIBLE_ENV_PATH = "/var/lib/jenkins/ansible-azure-env"
  }

  stages {
    stage('📥 Checkout Source') {
      steps {
        echo "📦 ล้าง workspace และดึง source code จาก Git"
        cleanWs()
        checkout scm
      }
    }

    stage('🔍 ตรวจสอบโฟลเดอร์ docker/Api') {
      steps {
        script {
          echo "🔍 ตรวจว่า docker/Api มีอยู่จริงใน Jenkins workspace..."
          sh '''
            if [ ! -d docker/Api ]; then
              echo "❌ ไม่พบโฟลเดอร์ docker/Api!"
              exit 1
            fi
          '''
          echo "📂 แสดงโครงสร้างไฟล์ docker/Api"
          sh 'ls -R docker/Api'
        }
      }
    }

    stage('📡 Get Public IP จาก Azure') {
      steps {
        withCredentials([
          string(credentialsId: 'AZURE_CLIENT_ID', variable: 'AZURE_CLIENT_ID'),
          string(credentialsId: 'AZURE_SECRET', variable: 'AZURE_SECRET'),
          string(credentialsId: 'AZURE_TENANT', variable: 'AZURE_TENANT'),
          string(credentialsId: 'AZURE_SUBSCRIPTION_ID', variable: 'AZURE_SUBSCRIPTION_ID')
        ]) {
          echo "🌐 เรียก get-vm-ip.yaml เพื่อสร้าง vm_ip.txt"
          sh """
            set -ex
            export ANSIBLE_HOST_KEY_CHECKING=False
            . $ANSIBLE_ENV_PATH/bin/activate
            ansible-playbook playbooks/get-vm-ip.yaml -e "@config/config-dev.yaml"
          """
        }
      }
    }

    stage('🐳 Build Docker Images') {
      steps {
        script {
          def ip = readFile('vm_ip.txt').trim()
          echo "⚙️ Build Docker images ที่เครื่อง ${ip}"
          sh """
            set -ex
            export ANSIBLE_HOST_KEY_CHECKING=False
            . \$ANSIBLE_ENV_PATH/bin/activate
            ansible-playbook -i ${ip}, \
              -u \$SSH_USER --private-key \$SSH_KEY \
              playbooks/build-all-images.yaml
          """
        }
      }
    }

    stage('🔍 Trivy Scan Docker Images') {
      steps {
        script {
          def ip = readFile('vm_ip.txt').trim()
          echo "🔍 Scan Docker images ที่เครื่อง ${ip}"
          sh """
            set -ex
            export ANSIBLE_HOST_KEY_CHECKING=False
            . \$ANSIBLE_ENV_PATH/bin/activate
            ansible-playbook -i ${ip}, \
              -u \$SSH_USER --private-key \$SSH_KEY \
              playbooks/scan-all-images.yaml
          """
        }
      }
    }
  }
}
